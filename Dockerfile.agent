FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN python -m venv /opt/venv
COPY pyproject.toml README.md requirements-container.txt ./
COPY agenttrust ./agenttrust
RUN pip install --no-cache-dir -r requirements-container.txt '.[gateway]'
COPY examples/container_demo.py examples/container_probe.py ./
USER 10001:10001
CMD ["python", "-c", "import time; time.sleep(2147483647)"]
